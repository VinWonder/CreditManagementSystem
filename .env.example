# Flask
FLASK_APP=run.py
FLASK_ENV=development
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
SESSION_COOKIE_SECURE=false
AUTO_CREATE_DB=true
# Sign everyone out when the server restarts (default: true in development,
# false in production; with several Gunicorn workers use it only with --preload).
SESSION_ENDS_ON_RESTART=true

# Database
# SQLite (default, zero-config, great for dev / demo on a kiosk laptop)
DATABASE_URL=sqlite:///credit_system.db
# PostgreSQL. URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/credit_system
# For PostgreSQL, run `flask --app run db upgrade`; tables are migration-managed.

# SMS Gateway: choose africastalking or twilio
SMS_PROVIDER=africastalking

# Africa's Talking. For sandbox, use username=sandbox and add your phone as a
# sandbox recipient. For live delivery, use production credentials.
AT_USERNAME=sandbox
AT_API_KEY=

# Twilio alternative. Configure either TWILIO_FROM_NUMBER or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp Business Cloud API (Meta)
# Leave blank to run in SIMULATED mode. Fill in both values from
# https://developers.facebook.com/docs/whatsapp/cloud-api to send live WhatsApp messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Password recovery
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
# SMS phone verification
PHONE_VERIFICATION_CODE_MINUTES=10
PHONE_VERIFICATION_MAX_ATTEMPTS=5
LOGIN_OTP_CODE_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_SECONDS=60
DEFAULT_PHONE_REGION=KE

# Email verification for new retailer accounts (SMTP).
# Leave SMTP_HOST blank in development: codes are printed in the Flask terminal.
# Production refuses to start without it. For Gmail, turn on 2-Step Verification
# and use an App Password (https://myaccount.google.com/apppasswords), not your
# normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
EMAIL_VERIFICATION_CODE_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_SECONDS=60

# Remember: retailers send reminders from their own phone, so no scheduler
# or daily scan is configured here.

# M-Pesa STK Push. Each shop's Paybill/Till and Daraja keys are saved by the
# developer with: flask --app run mpesa set <shop>  (see README). They are
# encrypted with this key; back it up and never change it once keys are saved.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGING_CREDENTIALS_ENCRYPTION_KEY=
# Public HTTPS address for Safaricom's payment callback (e.g. an ngrok URL).
PUBLIC_BASE_URL=
